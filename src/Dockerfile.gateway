# VeriTrack Stage 2 gateway — server tier only.
# Not used for the webcam demo itself: see README.md ("Stage 1 laptop demo")
# for why camera capture runs natively on Windows instead of in this image.
FROM python:3.12-slim AS base

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

COPY requirements-server.txt ./
RUN pip install --no-cache-dir -r requirements-server.txt \
    && pip install --no-cache-dir uvicorn[standard]

COPY veritrack_server ./veritrack_server

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=5 \
    CMD python -c "import urllib.request,sys; sys.exit(0) if urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=2).status==200 else sys.exit(1)"

CMD ["uvicorn", "veritrack_server.gateway:app", "--host", "0.0.0.0", "--port", "8080"]
