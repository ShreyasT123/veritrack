# Copy this file to .env and fill in real values before `docker compose up`
# for anything beyond a five-minute throwaway demo. Never commit the filled-in
# .env file.
#
# Generate real key material with (Git Bash / WSL2 / any Linux shell):
#   openssl rand -base64 32   ->  VERITRACK_CRYPTO_AES_MASTER_KEY
#   openssl rand -base64 64   ->  VERITRACK_CRYPTO_SALT_PEPPER
# On plain Windows PowerShell instead:
#   [Convert]::ToBase64String((1..32 | %{Get-Random -Max 256}))

VERITRACK_DB_USER=veritrack
VERITRACK_DB_PASSWORD=change-me
VERITRACK_DB_DATABASE=veritrack

VERITRACK_CRYPTO_AES_MASTER_KEY=
VERITRACK_CRYPTO_SALT_PEPPER=
# Leave the two above blank and this at "true" for a quick local demo only.
# Fill them in and set this to "false" for anything you'd show as a real
# DPDP-compliant deployment rather than a UI/plumbing demo.
VERITRACK_CRYPTO_ALLOW_INSECURE_DEFAULTS=true
